{
  "name": "fishing-logbook-web-tests",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "schema:generate": "node scripts/generate-schema-artifacts.mjs",
    "schema:check": "node scripts/generate-schema-artifacts.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "magic-string": "^1.4.2"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "esri-leaflet": "^3.0.16",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4"
  }
}
